{
  "name": "myhome",
  "version": "1.0.0",
  "private": true,
  "description": "A homepage that hosts standalone HTML web apps, with an admin panel to add/remove them.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:static": "node tools/export-static.js",
    "deploy": "node tools/export-static.js && npx wrangler deploy"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.0.2"
  }
}
