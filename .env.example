# Copy to .env and fill in.

PORT=3000
# Public URL of this site. OAuth redirect URIs are built from it.
BASE_URL=http://localhost:3000

# Random string used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Admin allowlist. Comma separated. For GitHub use the login, for Google use the email.
# Example: ADMIN_LOGINS=your-github-login,you@gmail.com
# '*' (= anyone who logs in) is a test-only value - never use it in production.
ADMIN_LOGINS=

# Optional bootstrap password for the password login. Normally you set/change the
# password from the admin UI (사이트 → 관리자 비밀번호); it is stored as a scrypt
# hash in data/admin.json, which is git-ignored. Leave this empty once set.
ADMIN_PASSWORD=

# --- GitHub OAuth App ---
# https://github.com/settings/developers -> New OAuth App
# Authorization callback URL: <BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google OAuth Client ---
# https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
# Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local-only escape hatch: set to 1 to enable /auth/dev-login?as=<ADMIN_LOGINS member>
# so you can log in without OAuth credentials. NEVER enable in production.
ALLOW_DEV_LOGIN=0
